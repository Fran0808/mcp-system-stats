{
  "name": "@fran0808/system-stats",
  "version": "2.0.1",
  "description": "Model Context Protocol (MCP) server for local system statistics, CPU, RAM, Disk, GPU, and process monitoring.",
  "type": "module",
  "main": "build/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fran0808/mcp-system-stats.git"
  },
  "bugs": {
    "url": "https://github.com/Fran0808/mcp-system-stats/issues"
  },
  "homepage": "https://github.com/Fran0808/mcp-system-stats#readme",
  "bin": {
    "system-stats": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:package": "node scripts/test-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "system-stats",
    "hardware-monitoring",
    "claude-desktop"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "systeminformation": "^5.33.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
